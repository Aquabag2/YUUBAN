# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API → Project URL
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
# Dashboard → Settings → API → service_role (⚠ nunca lo expongas en el cliente)
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
# Cambia esto a un string aleatorio largo en producción
JWT_SECRET=cambia_esto_por_algo_aleatorio_de_al_menos_32_caracteres
CORS_ORIGIN=http://localhost:3000
