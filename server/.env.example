# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API → Project URL
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
# Dashboard → Settings → API → service_role (⚠ nunca lo expongas en el cliente)
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# URL pública de la app (se usa en los enlaces de los correos y regresos de Stripe)
APP_URL=http://localhost:3000

# ─── Supabase Auth ───────────────────────────────────────────────────────────
# Dashboard → Settings → API → JWT Secret (verificación local de sesiones)
SUPABASE_JWT_SECRET=

# ─── Correos (Resend) ────────────────────────────────────────────────────────
# resend.com → API Keys. El dominio del remitente debe estar verificado en Resend.
RESEND_API_KEY=
EMAIL_FROM=Yuuban <hola@yuuban.mx>

# ─── Pagos (Stripe) ──────────────────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys (usa sk_test_... para pruebas)
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://TU_DOMINIO/api/stripe/webhook
# eventos: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=
# Logo de los correos: PNG público (p. ej. súbelo a client/public/logo-email.png → https://TU_DOMINIO/logo-email.png)
EMAIL_LOGO_URL=

# Cobros: false (o vacío) = todo gratis y Stripe apagado. Pon true cuando quieras cobrar.
PAYMENTS_ENABLED=false
